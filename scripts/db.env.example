# Copy to /opt/billgenie/db.env on the droplet (chmod 600). Never commit real passwords.
POSTGRES_USER=billgenie
POSTGRES_PASSWORD=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
POSTGRES_DB=billgenie
# Optional: bind address for published 5432 (default 0.0.0.0 — restrict via DO firewall / UFW)
# POSTGRES_BIND_HOST=0.0.0.0
