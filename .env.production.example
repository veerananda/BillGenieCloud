# BillGenie Restaurant API — production checklist (NO real secrets in git)
# Copy to a local .env.production if needed for reference, or set Fly secrets:
#   .\scripts\set-fly-secrets.ps1
# Template: scripts\fly-secrets.example.env

API_BASE_URL=https://billgenie-api.fly.dev
PUBLIC_APP_URL=https://thebillgenie.com
PORT=3000
SERVER_ENV=production
LOG_LEVEL=info

# Set via secrets / /opt/billgenie/.env — never commit real values
# Droplet local Postgres (see DEPLOY_DROPLET.md) — sslmode=disable is required:
# DATABASE_URL=postgresql://billgenie:PASSWORD@billgenie-postgres:5432/billgenie?sslmode=disable
# DATABASE_URL=
# REDIS_URL=
# JWT_SECRET=   (min 32 chars, unique)
# REFRESH_JWT_SECRET=  (min 32 chars, different from JWT_SECRET)
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=
# PLATFORM_OPS_API_KEY=

# Production CORS must be an explicit allowlist (no *). Localhost is for local web only —
# omit it on the live Fly secret once you no longer point local web at prod API.
CORS_ALLOWED_ORIGINS=https://thebillgenie.com,https://www.thebillgenie.com

ENABLE_PAYMENT=true
ENABLE_WEBSOCKET=true
ENABLE_LOGGING=false
ENABLE_LOCALHOST_CORS_IN_PROD=false
